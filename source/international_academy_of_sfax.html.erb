---
layout: "layout"
title: "International Academy of Sfax | Lead Education Group"
background_color: "light-blue"
bottom_div_color: "white"
---

<main role="main">

  <section class="lead-main" aria-label="Lead Eduction Group Hero">
      <div class="container">
        <div class="lead-main-inner">
          <div class="lead-main-text">
            <h1>Our Approach</h1>
            <p>LEAD Education Group believes that education is a primary means to future success for individuals, societies and for entire nations.</p>
            <p>Through the vehicle of international schools, students are given opportunity to become successful and influential leaders who will promote systemic and positive change in their societies and nations.</p>
          </div>
          <%= image_tag '0.jpg', class: 'lead-main-image', alt: 'International Academy of Sfax' %>
        </div>
      </div>
    </section>

  <section aria-label="first" class="section-second-home">
    <div class="container">
      <div class="row">
        <div class="col-12 banner-d-flex">
          <div class="inner-text center">
            <p class="top-accent-text">A model school</p>
            <h3>The International Academy of Sfax</h3>
            <%= image_tag 'iasfax_logo.png', class: "small-logo", alt: 'International Academy of Sfax logo' %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section aria-label="fifth" class="banner-section pt-5 bg-background-color">
    <div class="container">
      <div class="d-flex flex-column align-items-center text-center">
        <p style="width: 320px;">Visit the website</p>
        <p><a class="cta cta-primary cta-fit-width" href="https://iasfax.com/" role="button">IASfax.com</a></p>
      </div>
    </div>
  </section>
</main>

<div class="bg-hero green"></div>

