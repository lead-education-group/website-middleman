---
layout: "layout"
title: "Our Approach | International Academy of Sfax | Lead Education Group"
background_color: "light-blue"
bottom_div_color: "white"
image: "0.jpg"
description: "We believe that education is a primary means for the future success of individuals, societies, and nations. Our approach can be outlined by looking at an international school that we established in Sfax, Tunisia."
tags: "International Academy of Sfax, Lead Education Group, IASfax Lead Education, Lead Education Group Sfax, Lead Education Sfax, Lead Education Tunisia, Tunisia International School, Sfax Tunisia school, Lead Education International Academy of Sfax, IASfax"
---

<main role="main">

  <section class="lead-main" aria-label="Lead Eduction Group Hero">
      <div class="container">
        <div class="lead-main-inner">
          <div class="lead-main-text">
            <h1>Our Approach</h1>
            <%= markdown(data.what_we_do.header_description) %>
          </div>
          <%= image_tag '0.jpg', class: 'lead-main-image shadow--stronger', alt: 'International Academy of Sfax' %>
        </div>
      </div>
    </section>

  <section aria-label="first" class="section-second-home pt-5 pb-2">
    <div class="container">
      <div class="row">
        <div class="col-12 banner-d-flex">
          <div class="inner-text center">
            <p class="top-accent-text">A model school</p>
            <h3>The International Academy of Sfax</h3>
            <%= image_tag 'iasfax_logo.png', class: "small-logo", alt: 'International Academy of Sfax logo' %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section aria-label="third" class="banner-section bg-very-light-blue my-5">
    <div class="container">
      <div class="row direction-reverse-on-small">
        <div class="col-sm-12 col-md-6 banner-d-flex">
          <div class="inner-text max-width-420-md">
            <h3><%= data.what_we_do.section_one_title %></h3>
            <%= markdown(data.what_we_do.section_one_body) %>
          </div>
        </div>
        <div class="col-sm-12 col-md-6 banner-d-flex">
          <%= image_tag 'iasfax.jpg', class: 'section-image', alt: 'International Acacdemy of Sfax' %>
        </div>
      </div>
    </div>
  </section>

  <section aria-label="third" class="banner-section my-5">
    <div class="container">
      <div class="row">
        <div class="col-sm-12 col-md-6 banner-d-flex">
          <%= image_tag 'iasfax-3.jpg', class: 'section-image shadow--stronger' %>
        </div>
        <div class="col-sm-12 col-md-6 banner-d-flex">
          <div class="inner-text max-width-420-md">
            <h3><%= data.what_we_do.section_two_title %></h3>
            <%= markdown(data.what_we_do.section_two_body) %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section aria-label="fifth" class="banner-section pt-5 bg-light-red">
    <div class="container">
      <div class="d-flex flex-column align-items-center text-center">
        <p style="width: 320px;"><%= data.what_we_do.learn_more_prompt %></p>
        <p><a class="cta cta-primary cta-fit-width" href="https://iasfax.com/" role="button">IASfax.com</a></p>
      </div>
    </div>
  </section>
</main>

<div class="bg-hero red"></div>

