---
layout: "layout"
title: "Who We Are | Lead Education Group"
background_color: "white"
header_color: "transparent"
image: "sfax-kids.jpg"
description: "LEAD Education Group believes that education is a primary means to future success for individuals, societies and for entire nations. Through the vehicle of international schools, students are given opportunity to become successful and influential leaders who will promote systemic and positive change in their societies and nations."
tags: "Lead Education Group, Lead Education Group Who we are, Lead Education Group About, Steve Beck, Stephen Beck, Stephen Beck, Ph.D"
---

<main role="main">

  <section class="lead-main" aria-label="Lead Eduction Group Hero">
    <div class="container">
      <div class="lead-main-inner">
        <div class="lead-main-text">
          <h1>Who We Are</h1>
          <%= markdown(data.who_we_are.header_description) %>
        </div>
        <%= image_tag 'sfax-kids.jpg', class: 'lead-main-image' %>
      </div>
    </div>
  </section>

  <section aria-label="second" class="section-second-home">
    <div class="container">
      <div class="row">
        <div class="col-12 banner-d-flex">
          <div class="inner-text center">
            <p class="top-accent-text">Special Focus</p>
            <h3><%= data.who_we_are.letter_section_title %></h3>
          </div>
        </div>
      </div>
    </div>
    <div class="executive-director-container">
      <div class="container">
        <div class="row">
          <div class="col-12 banner-d-flex">
            <div class="executive-director">
              <%= image_tag 'stephen_beck.jpg', class: 'Stephen-Beck', alt: 'Stephen Beck, Ph.D.' %>
              <div>
                <h4>Stephen Beck, Ph.D.</h4>
                <p>Executive Director</p>
                <p>LEAD Education Group, Inc.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="bg-very-light-blue">
      <div class="container">
        <div class="statement">
          <div class="inner-text">
            <%= markdown(data.who_we_are.letter_section_body) %>

            <%= image_tag 'stephen_beck_signature.png', class: 'Stephen-Beck-Signature', alt: 'Stephen Beck signature' %>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<div class="bg-hero purple"></div>
