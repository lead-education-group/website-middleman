---
layout: "layout"
title: "Lead Education Group | Establishing Schools of Distinction"
background_color: "white"
header_color: "transparent"
image: "beanbags.jpg"
description: "Establishing international schools of distinction for future success. The most reliable pathway to success, in an interconnected
  world, is an international education."
tags: "Lead Education Group, Lead Education Group Home, LEAD Education, Lead Education, Lead International School, Lead Schools, Lead International School, Lead School"
---
<main role="main">

  <section class="lead-hero" aria-label="Lead Eduction Group Hero">
    <div class="container">
      <div class="lead-hero-inner">
        <div class="lead-hero-text">
          <h1><%= data.home.header %></h1>
          <p><%= data.home.header_description %></p>
          <p class="mt-4"><a class="cta cta-primary cta-fit-width" href="international_academy_of_sfax.html" role="button">Learn about Schools of Distinction</a></p>
        </div>
        <div class="lead-hero-image">
          <%= image_tag 'beanbags.jpg', id: 'hero-image-1', style: 'aspect-ratio: 1534 / 1108;' %>
          <%= image_tag 'playground.jpg', id: 'hero-image-2', style: 'aspect-ratio: 1558 / 1365;' %>
          <%= image_tag 'classroom.jpg', id: 'hero-image-3', style: 'aspect-ratio: 907 / 1362;' %>
        </div>
      </div>
    </div>
  </section>

  <section aria-label="second" class="section-second-home lg-some mb-4">
    <div class="container">
      <div class="row">
        <div class="col-sm-12 col-md-6 banner-d-flex">
          <div id="globe-image"></div>
        </div>
        <div class="col-sm-12 col-md-6 banner-d-flex">
          <div class="inner-text">
            <p class="top-accent-text">The Challenge</p>
            <h3><%= data.home.challenge_title %></h3>
            <%= markdown(data.home.challenge_body) %>
        </div>
      </div>
    </div>
  </section>

  <section aria-label="third" class="banner-section svg-borders-section bg-light-green">
    <div class="container">
      <div class="row direction-reverse-on-small">
        <div class="col-sm-12 col-md-6 banner-d-flex">
          <div class="inner-text max-width-420-md">
            <p class="top-accent-text">The Opportunity</p>
            <h3><%= data.home.opportunity_title %></h3>
            <%= markdown(data.home.opportunity_body) %>
          </div>
        </div>
        <div class="col-sm-12 col-md-6 banner-d-flex">
          <%= image_tag 'autumn-festival.jpg', class: 'section-image', style: 'aspect-ratio: 2048 / 1365; object-fit: cover;' %>
        </div>
      </div>
    </div>
  </section>

  <section aria-label="fourth" class="banner-section">
    <div class="container">
      <div class="row">
        <div class="col-12 banner-d-flex">
          <div class="inner-text center">
            <p class="top-accent-text">Our Approach</p>
            <h3><%= data.home.approach_title %></h3>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-sm-12 col-md-4">
          <div class="lead-column">
            <div class="header-icon" id="apple"></div>
            <div class="inner-text">
              <h4><%= data.home.approach_element_one_title %></h4>
              <%= markdown(data.home.approach_element_one_body) %>
            </div>
          </div>
        </div>

        <div class="col-sm-12 col-md-4">
          <div class="lead-column">
            <div class="header-icon" id="ribbon"></div>
            <div class="inner-text">
              <h4><%= data.home.approach_element_two_title %></h4>
              <%= markdown(data.home.approach_element_two_body) %>
            </div>
          </div>
        </div>

        <div class="col-sm-12 col-md-4">
          <div class="lead-column">
            <div class="header-icon" id="globe"></div>
            <div class="inner-text">
              <h4><%= data.home.approach_element_three_title %></h4>
              <%= markdown(data.home.approach_element_three_body) %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section aria-label="fifth" class="banner-section pt-6 bg-light-red">
    <div class="container">
      <div class="d-flex flex-column align-items-center text-center">
        <p style="width: 320px;">Have an inquiry? Want to partner with us? Send us a message and let's explore how we can work together.</p>
        <p><a class="cta cta-primary cta-fit-width" href="contact.html" role="button">Contact Us</a></p>
      </div>
    </div>
  </section>

</main>

<div class="bg-hero blue"></div>
