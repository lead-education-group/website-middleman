---
layout: "layout"
title: "Contact | Lead Education Group"
background_color: "light-blue"
---

<main role="main">

  <div class="bg-background-color">
    <div class="container">
      <section class="lead-section" aria-label="Lead Eduction Group Hero">
          <div class="lead-section-inner">
            <div class="lead-section-text pb-0">
              <p class="top-accent-text">Get in touch</p>
              <h1>Contact Us</h1>
              <div class="center-piece">
                <div class="backdrop wider">
                  <i class="fas fa-envelope fa-2x"></i>
                </div>
              </div>
              <div class="sub-center-piece">
                  <a href="mailto:info@leadeducationgroup.com"> info@leadeducationgroup.com
                  </a>
                  <a href="tel:16309959011">+1 (630) 995-9011</a>
              </div>
              <p class="text-left">We look forward to partnering with and working for you! Together we can transform education and create unprecedented opportunities for personal growth, professional development and lifelong careers within your community and your country as a whole.</p>
            </div>
          </div>
      </section>
    </div>
  </div>

  <section aria-label="second" class="section-after-header">
    <div class="container mb-5">
      <div class="section-after-header--inner">
        <form class="lead-contact-form" action="https://formspree.io/mgelzlwo" method="POST">

          <div class="form-group">
            <label for="exampleFormControlInput1">Name *</label>
            <input type="text" name="name" class="form-control" required>
          </div>

          <div class="form-group">
            <label for="company">Company</label>
            <input type="text" name="company" class="form-control" id="company">
          </div>

          <div class="form-group">
            <label for="position">Position</label>
            <input type="text" name="position" class="form-control" id="position">
          </div>

          <div class="form-group">
            <label for="email">Email *</label>
            <input type="text" name="_replyto" class="form-control" id="email" placeholder="name@example.com" required>
          </div>

          <div class="form-group">
            <label for="phone">Phone</label>
            <input type="text" name="phone" class="form-control" id="phone">
          </div>

          <div class="form-group">
            <label for="country">Country *</label>
            <input type="text" name="country" class="form-control" id="country" required>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <label for="message">Message *</label>
            <textarea name="message" class="form-control" id="message" rows="3" required></textarea>
          </div>

          <div>
            <button type="submit" class="cta cta-primary" style="border:none;width:100%;margin-top:30px;">Send</button>
          </div>
        </form>
    </div>
  </section>

</main>

