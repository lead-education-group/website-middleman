---
layout: "layout"
title: "Contact | Lead Education Group"
background_color: "light-blue"
image: "envelope.png"
description: "Lead Education Group looks forward to partnering with and working for you! Together we can transform education and create unprecedented opportunities for personal growth, professional development and lifelong careers within your community and your country as a whole."
tags: "Lead Education Group, Lead Education Group Contact"
---

<main role="main">

  <div class="container">
    <section class="lead-section" aria-label="Lead Eduction Group Hero">
        <div class="lead-section-inner">
          <div class="lead-section-text pb-2">
            <!-- <p class="top-accent-text">Get in touch</p> -->
            <div class="header-icon contact" id="envelope"></div>
            <h1>Contact Us</h1>
            <div class="sub-center-piece">
                <a href="mailto:info@leadeducationgroup.com"> info@leadeducationgroup.com
                </a>
                <a href="tel:16309959011">+1 (630) 995-9011</a>
            </div>
            <p class="text-left"><%= data.contact.prompt %></p>
          </div>
        </div>
    </section>
  </div>

  <div class="bg-light-blue">
    <section aria-label="second" class="section-after-header">
      <div class="container pb-5">
        <div class="section-after-header--inner">
          <form class="lead-contact-form" action="https://formspree.io/f/mgelzlwo" method="POST">

            <div class="form-group">
              <label for="exampleFormControlInput1">Name *</label>
              <input type="text" name="name" class="form-control" required>
            </div>

            <div class="form-group">
              <label for="company">Company</label>
              <input type="text" name="company" class="form-control" id="company">
            </div>

            <div class="form-group">
              <label for="position">Position</label>
              <input type="text" name="position" class="form-control" id="position">
            </div>

            <input type="text" name="_gotcha" style="display:none" />

            <div class="form-group">
              <label for="email">Email *</label>
              <input type="text" name="_replyto" class="form-control" id="email" placeholder="name@example.com" required>
            </div>

            <div class="form-group">
              <label for="phone">Phone</label>
              <input type="text" name="phone" class="form-control" id="phone">
            </div>

            <div class="form-group">
              <label for="country">Country *</label>
              <input type="text" name="country" class="form-control" id="country" required>
            </div>

            <div class="form-group" style="margin-bottom: 0;">
              <label for="message">Message *</label>
              <textarea name="message" class="form-control" id="message" rows="3" required></textarea>
            </div>

            <input type="hidden" name="_subject" value="Contact Form from LeadEducationGroup.com" >
            <input type="hidden" name="_next" value="<%= data.general.root %>/success-message-received.html" >

            <div>
              <button type="submit" class="cta cta-primary" style="border:none;width:100%;margin-top:30px;">Send</button>
            </div>
          </form>
      </div>
    </section>
  </div>

</main>

